# Copy to .env, fill only what you use, never commit it.
#
# Keys are per person. Do not share yours with the people you set up.
# Only `./forge.sh transcribe` needs these. Render and captions need no key.

# Transcription providers
ELEVENLABS_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
NAIJALINGO_API_KEY=
SPEECHYOU_API_KEY=

# Hugging Face, also used by the local NCAIR engine
HF_TOKEN=

# Optional. 9jaLingo can use a public audio URL, for example a Cloudinary upload.
CLOUDINARY_URL=

# Optional model overrides. Leave blank to use the defaults.
# ELEVENLABS_STT_MODEL=scribe_v2
# GROQ_MODEL=whisper-large-v3
# DEEPINFRA_MODEL=openai/whisper-large-v3
# NAIJALINGO_MODEL=
# SPEECHYOU_STT_MODEL=multilingual_pro
# HF_ASR_MODEL=NCAIR1/Yoruba-ASR
